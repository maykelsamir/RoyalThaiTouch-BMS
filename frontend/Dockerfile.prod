FROM node:20-alpine AS build
WORKDIR /app
COPY package.json .
RUN npm install
COPY . .
RUN sed -i "s|const API='http://localhost:8000';|const API=window.location.origin + '/api';|" src/main.jsx
RUN node patch-branches.cjs
RUN node patch-auth.cjs
RUN node patch-mobile.cjs
RUN node patch-pwa.cjs
RUN node patch-staff-entry.cjs
RUN node patch-staff-branch-lock.cjs
RUN node patch-month-status-admin-only.cjs
RUN node patch-final-menu-order.cjs
RUN node patch-dashboard-v2.cjs
RUN node patch-sidebar-groups.cjs
RUN node patch-center-pages.cjs
RUN node patch-calendar-page.cjs
RUN node patch-reports-v2.cjs
RUN node patch-granular-permissions.cjs
RUN node patch-role-home-pages.cjs
RUN node patch-modern-design.cjs
RUN npm run build
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/public /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
